<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="14dp"
    android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="SIESTE RAPIDE" android:textColor="#073A45" android:textSize="16sp"
        android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/nap20" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="44dp" android:gravity="center" android:background="@drawable/widget_button"
            android:text="20 min" android:textColor="#003D48" android:textStyle="bold"/>
        <Space android:layout_width="8dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/nap30" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="44dp" android:gravity="center" android:background="@drawable/widget_button"
            android:text="30 min" android:textColor="#003D48" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
